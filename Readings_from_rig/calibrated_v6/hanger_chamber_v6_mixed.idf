RunPeriod,
    V6_ValidationDay,        !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    1997,                    !- Begin Year
    1,                       !- End Month
    1,                       !- End Day of Month
    1997,                    !- End Year
    Wednesday,               !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    No,                      !- Apply Weekend Holiday Rule
    No,                      !- Use Weather File Rain Indicators
    No;                      !- Use Weather File Snow Indicators

ZoneInfiltration:DesignFlowRate,

  Chamber_Infiltration,                   !- Name
  Chamber,                                !- Zone or ZoneList or Space or SpaceList Name
  ,                                       !- Schedule Name
  AirChanges/Hour,                        !- Design Flow Rate Calculation Method
  ,                                       !- Design Flow Rate {m3/s}
  ,                                       !- Flow Rate per Floor Area {m3/s-m2}
  ,                                       !- Flow Rate per Exterior Surface Area {m3/s-m2}
 0.0110,                                    !- Air Changes per Hour {1/hr}
  ,                                       !- Constant Term Coefficient
  ,                                       !- Temperature Term Coefficient
  ,                                       !- Velocity Term Coefficient
  ,                                       !- Velocity Squared Term Coefficient
  Outdoor;                                !- Density Basis

ZoneControl:Thermostat,
  Chamber_ThermalZone Thermostat,         !- Name
  Chamber_ThermalZone,                    !- Zone or ZoneList Name
  Chamber_ThermalZone Thermostat Schedule, !- Control Type Schedule Name
  ThermostatSetpoint:SingleCooling,       !- Control 1 Object Type
  Thermostat Setpoint Single Cooling 2,   !- Control 1 Name
  ,                                       !- Control 2 Object Type
  ,                                       !- Control 2 Name
  ,                                       !- Control 3 Object Type
  ,                                       !- Control 3 Name
  ,                                       !- Control 4 Object Type
  ,                                       !- Control 4 Name
  0;                                      !- Temperature Difference Between Cutout And Setpoint {deltaC}

Schedule:Compact,
  Chamber_ThermalZone Thermostat Schedule, !- Name
  Chamber_ThermalZone Thermostat Schedule Type Limits, !- Schedule Type Limits Name
  Through: 12/31,                         !- Field 1
  For: AllDays,                           !- Field 2
  Until: 24:00,                           !- Field 3
  2;                                      !- Field 4 (Single Cooling)

ScheduleTypeLimits,
  Chamber_ThermalZone Thermostat Schedule Type Limits, !- Name
  0,                                      !- Lower Limit Value {BasedOnField A3}
  4,                                      !- Upper Limit Value {BasedOnField A3}
  DISCRETE;                               !- Numeric Type

ThermostatSetpoint:SingleCooling,
  Thermostat Setpoint Single Cooling 2,   !- Name
  COOLING_SETPOINT_SCH;                   !- Cooling Setpoint Temperature Schedule Name

ScheduleTypeLimits,
  Temperature,                            !- Name
  ,                                       !- Lower Limit Value {BasedOnField A3}
  ,                                       !- Upper Limit Value {BasedOnField A3}
  Continuous,                             !- Numeric Type
  temperature;                            !- Unit Type

Schedule:Compact,
  HEATING_SETPOINT_SCH,                   !- Name
  Temperature,                            !- Schedule Type Limits Name
  Through: 12/31,                         !- Field 1
  For: AllDays,                           !- Field 2
  Until: 24:00,                           !- Field 3
  10.0;                                   !- Constant Heating Setpoint 10.0 C

Schedule:Compact,
  COOLING_SETPOINT_SCH,                   !- Name
  Temperature,                            !- Schedule Type Limits Name
  Through: 12/31,                         !- Field 1
  For: AllDays,                           !- Field 2
  Until: 13:25, 29.68,
  Until: 16:16, 20.0,
  Until: 24:00, 29.68;

                                   !- Ambient Equilibrium Setpoint 29.9 C

Schedule:Compact,
  PRE_TEST_HEAT_SOAK_SCH,                 !- Name
  Fraction,                               !- Schedule Type Limits Name
  Through: 12/31,                         !- Field 1
  For: AllDays,                           !- Field 2
  Until: 07:40,                           !- Time 1
  1.0,                                    !- Heat soak ON (00:00 to 07:40 AM)
  Until: 24:00,                           !- Time 2
  0.0;                                    !- Heat soak OFF (07:40 AM onwards)

OtherEquipment,
  Chamber_PreTest_HeatSoak,               !- Name
  None,                                   !- Fuel Type
  Chamber_ThermalZone,                    !- Zone Name
  PRE_TEST_HEAT_SOAK_SCH,                 !- Schedule Name
  EquipmentLevel,                         !- Design Level Calculation Method
  320,                                    !- Design Level {W} (320 W pre-test thermal soak to hit 29.9 C at 07:44 AM)
  ,                                       !- Power per Zone Floor Area {W/m2}
  ,                                       !- Power per Person {W/person}
  0.0,                                    !- Fraction Latent
  1.0,                                    !- Fraction Radiant
  0.0;                                    !- Fraction Lost

ZoneHVAC:EquipmentConnections,
  Chamber_ThermalZone,                    !- Zone Name
  Chamber_ThermalZone Equipment List,     !- Zone Conditioning Equipment List Name
  Chamber_ThermalZone Inlet Node List,    !- Zone Air Inlet Node or NodeList Name
  Chamber_ThermalZone Exhaust Node List,  !- Zone Air Exhaust Node or NodeList Name
  Node 2;                                 !- Zone Air Node Name

NodeList,
  Chamber_ThermalZone Inlet Node List,    !- Name
  Node 6;                                 !- Node Name 1

NodeList,
  Chamber_ThermalZone Exhaust Node List,  !- Name
  Node 5;                                 !- Node Name 1

ZoneHVAC:PackagedTerminalAirConditioner,
  Chamber_SplitAC,                        !- Name
  Always On Discrete,                     !- Availability Schedule Name
  Node 5,                                 !- Air Inlet Node Name
  Node 6,                                 !- Air Outlet Node Name
  OutdoorAir:Mixer,                       !- Outdoor Air Mixer Object Type
  Chamber_SplitAC OA Mixer,               !- Outdoor Air Mixer Name
  0.05,                                   !- Cooling Supply Air Flow Rate {m3/s} (~100 CFM)
  0.05,                                   !- Heating Supply Air Flow Rate {m3/s}
  0.05,                                   !- No Load Supply Air Flow Rate {m3/s}
  Yes,                                    !- No Load Supply Air Flow Rate Control Set To Low Speed
  0.01,                                   !- Cooling Outdoor Air Flow Rate {m3/s} (~20 CFM)
  0.01,                                   !- Heating Outdoor Air Flow Rate {m3/s}
  0.01,                                   !- No Load Outdoor Air Flow Rate {m3/s}
  Fan:OnOff,                              !- Supply Air Fan Object Type
  Fan On Off 1,                           !- Supply Air Fan Name
  Coil:Heating:Electric,                  !- Heating Coil Object Type
  Coil Heating Electric 1,                !- Heating Coil Name
  Coil:Cooling:DX:SingleSpeed,            !- Cooling Coil Object Type
  Coil Cooling DX Single Speed 1,         !- Cooling Coil Name
  DrawThrough,                            !- Fan Placement
  Always Off Discrete;                    !- Supply Air Fan Operating Mode Schedule Name (Cycling Fan & Compressor with Thermostat Cutout)

