EnergyManagementSystem:Sensor,
  Supply_Flow_Sched_Val,
  SUPPLY_FLOW_FRACTION_SCH,
  Schedule Value;

EnergyManagementSystem:Actuator,
  Set_Chamber_Supply_Flow,
  CHAMBER_IDEALLOADS,
  Ideal Loads Air System,
  Air Mass Flow Rate;

EnergyManagementSystem:Sensor,
  Supply_Temp_Sched_Val,                  !- Name
  SUPPLY_TEMP_SCH,                        !- Output:Variable or Schedule Name
  Schedule Value;                         !- Output:Variable Index Key Name

EnergyManagementSystem:Actuator,
  Set_Chamber_Supply_Temp,                !- Name
  CHAMBER_IDEALLOADS,                     !- Component Unique Name
  Ideal Loads Air System,                 !- Component Type
  Air Temperature;                        !- Control Type

EnergyManagementSystem:Program,
  Set_Supply_Temp_Program,                !- Name
  Set Set_Chamber_Supply_Temp = Supply_Temp_Sched_Val, !- Program Line 1
  Set Set_Chamber_Supply_Flow = Supply_Flow_Sched_Val * 0.11404; !- Program Line 2

EnergyManagementSystem:ProgramCallingManager,
  Set_Supply_Temp_Manager,                !- Name
  InsideHVACSystemIterationLoop,          !- EnergyPlus Model Calling Point
  Set_Supply_Temp_Program;                !- Program Name 1
